  "default_policy": {
    "workspace_escape": "deny",
    "network": "deny_except_configured_loopback_providers",
    "system_modification": "deny",
    "software_installation": "deny",
    "process_control": "owned_processes_only",
    "writes": "durable_transaction_required",
    "agent_read_only_modes": [
      "inspect",
      "plan"
    ],
    "agent_mutating_modes": [
      "apply",
      "repair"
    ],
    "mutating_agent_commit": "human_review_required",
    "grounded_first_project_turn": "required"
