{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex_incident.v1",
  "type": "object",
  "required": ["schema", "incident_id", "opened_unix_ms", "title", "fingerprint", "status", "severity", "first_event_id", "last_event_id"],
  "properties": {
    "schema": {"const": "cortex.incident.v1"},
    "incident_id": {"type": "string"},
    "project_id": {"type": ["string", "null"]},
    "opened_unix_ms": {"type": "integer", "minimum": 0},
    "closed_unix_ms": {"type": ["integer", "null"], "minimum": 0},
    "title": {"type": "string"},
    "fingerprint": {"type": "string"},
    "status": {"type": "string"},
    "severity": {"enum": ["trace", "debug", "info", "warning", "error", "critical"]},
    "first_event_id": {"type": "string"},
    "last_event_id": {"type": "string"},
    "related_event_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_paths": {"type": "array", "items": {"type": "string"}},
    "resolution_summary": {"type": ["string", "null"]},
    "successful_patch_id": {"type": ["string", "null"]},
    "successful_build_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
