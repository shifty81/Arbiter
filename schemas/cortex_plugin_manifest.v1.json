{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cortex Plugin Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "permissions": {
      "type": "array"
    },
    "tools": {
      "type": "array"
    },
    "workspace_kinds": {
      "type": "array"
    }
  }
}