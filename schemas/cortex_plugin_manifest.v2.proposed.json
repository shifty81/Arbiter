{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortex.local/schemas/cortex_plugin_manifest.v2.json",
  "title": "Cortex Plugin Manifest v2 (proposed)",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "compatibility",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "cortex"
      ],
      "properties": {
        "cortex": {
          "type": "string"
        },
        "protocols": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "mcp_stdio",
              "mcp_http",
              "pcc_cli",
              "lsp_stdio",
              "dap_stdio",
              "bsp_stdio",
              "cortex_rpc",
              "tool_provider"
            ]
          },
          "executable": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "local_only": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ui_contributions": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_home_cards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "settings_schema": {
          "type": "string"
        }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}