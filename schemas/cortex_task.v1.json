{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cortex Task v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "created_unix_ms",
    "updated_unix_ms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    }
  }
}