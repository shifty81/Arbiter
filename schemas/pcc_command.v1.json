{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortex.local/schemas/pcc_command.v1.json",
  "title": "Universal PCC command v1",
  "type": "object",
  "required": ["key", "program", "risk"],
  "additionalProperties": true,
  "properties": {
    "key": {"type": "string", "minLength": 1},
    "label": {"type": "string"},
    "program": {"type": "string", "minLength": 1},
    "args": {"type": "array", "items": {"type": "string"}},
    "risk": {"enum": ["read_only", "local_mutation", "source_mutation", "external_mutation"]},
    "side_effects": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "network_required": {"type": "boolean"},
    "cancellation": {"type": "string"},
    "rollback": {"type": "string"}
  }
}
