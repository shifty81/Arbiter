{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cortex Desktop Bootstrap v2",
  "type": "object",
  "required": [
    "schema_version",
    "workspace",
    "state_root",
    "conversations",
    "layout",
    "settings",
    "permissions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "workspace": {
      "type": "object"
    },
    "state_root": {
      "type": "string"
    },
    "service": {
      "type": [
        "object",
        "null"
      ]
    },
    "conversations": {
      "type": "array"
    },
    "layout": {
      "type": "object"
    },
    "settings": {
      "type": "object"
    },
    "permissions": {
      "type": "object"
    }
  }
}