{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open2d.local/schemas/cortex_universal.v1.json",
  "title": "Cortex Universal M11 Contracts",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/genericCommandProfile"},
    {"$ref": "#/$defs/imageGenerationRecipe"},
    {"$ref": "#/$defs/modelCapabilityProfile"}
  ],
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "genericCommandProfile": {
      "type": "object",
      "properties": {
        "format": {"$ref": "#/$defs/command"},
        "lint": {"$ref": "#/$defs/command"},
        "validate": {"$ref": "#/$defs/command"},
        "build": {"$ref": "#/$defs/command"},
        "test": {"$ref": "#/$defs/command"},
        "run": {"$ref": "#/$defs/command"},
        "artifact": {"type": "string"},
        "expected_window": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "imageGenerationRecipe": {
      "type": "object",
      "required": ["schema_version", "intent", "prompt", "width", "height", "count"],
      "properties": {
        "schema_version": {"const": 1},
        "intent": {"type": "string"},
        "prompt": {"type": "string"},
        "negative_prompt": {"type": ["string", "null"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "count": {"type": "integer", "minimum": 1},
        "seed": {"type": ["integer", "null"], "minimum": 0},
        "model": {"type": ["string", "null"]},
        "workflow_profile": {"type": ["string", "null"]},
        "reference_images": {"type": "array", "items": {"type": "string"}},
        "input_images": {"type": "array", "items": {"type": "string"}},
        "masks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "modelCapabilityProfile": {
      "type": "object",
      "required": ["id", "max_reliable_visible_tools"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {"type": ["string", "null"]},
        "context_window": {"type": ["integer", "null"], "minimum": 1},
        "reliable_context_window": {"type": ["integer", "null"], "minimum": 1},
        "max_reliable_visible_tools": {"type": "integer", "minimum": 1, "maximum": 64},
        "supports_chat": {"type": "boolean"},
        "supports_code": {"type": "boolean"},
        "supports_vision": {"type": "boolean"},
        "supports_embeddings": {"type": "boolean"},
        "supports_native_tools": {"type": "boolean"},
        "supports_constrained_json": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
