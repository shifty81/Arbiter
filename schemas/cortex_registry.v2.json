{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cortex Workspace Registry v2",
  "type": "object",
  "required": [
    "schema_version",
    "workspaces"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "active_workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "root",
          "known_paths",
          "fingerprint",
          "state_root",
          "profile",
          "attached_unix_ms",
          "last_opened_unix_ms"
        ]
      }
    }
  }
}
