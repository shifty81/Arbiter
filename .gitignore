# Rust
/target/
**/target/

# Node/editor bridge
**/node_modules/
**/dist/
**/.parcel-cache/

# Local Cortex runtime/state
/.cortex/
/.open2d/
*.local.json
.env
.env.*
!.env.example

# PCC/runtime evidence generated locally
/artifacts/debug-bundles/
/artifacts/source-refresh/
/artifacts/handoffs/
/artifacts/diagnostics/
/artifacts/migration/pre-import-*/
/logs/
/state/

# Update packages are governed artifacts, not source.
# Keep the inbox marker but do not commit transient ZIPs.
/updates/inbox/*.zip
!/updates/inbox/.gitkeep

# Secrets / credentials
*.pem
*.pfx
*.p12
*.key
*credential*
*secret*
*token*

# OS/editor
.DS_Store
Thumbs.db
.vs/
.idea/
.vscode/*.log

# Build/package residue
*.tmp
*.bak
*.orig
