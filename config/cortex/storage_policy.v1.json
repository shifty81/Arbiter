{
  "schema_version": 1,
  "mode": "catalog_first",
  "default_library_root_windows": "D:\\CortexLibrary",
  "permissions": {
    "catalog": "read_only",
    "classify": "read_only",
    "hash": "read_only",
    "register_project": "approval",
    "initialize_git": "approval",
    "move": "approval",
    "deduplicate": "approval",
    "delete": "explicit_approval",
    "deep_personal_content_analysis": "off"
  },
  "storage_classes": {
    "project_source": "git_candidate",
    "project_content": "project_or_vault_by_policy",
    "documentation": "project_or_vault_by_context",
    "archive_backup": "artifact_or_lineage",
    "generated_build": "rebuildable_cache",
    "dependency_vendor": "dependency_or_vendor",
    "toolchain_installed": "external_tooling",
    "model_data": "models_store",
    "media": "catalog_only_by_default",
    "personal_non_project": "catalog_only_no_semantic_ingest",
    "unknown": "inbox"
  },
  "migration": {
    "dry_run_required": true,
    "rollback_manifest_required": true,
    "verify_destination_hashes": true,
    "quarantine_before_delete": true,
    "auto_delete_originals": false,
    "auto_merge_project_copies": false
  }
}
