{
  "server_id": "example_server",
  "name": "My Game Server",
  "app_id": 896660,
  "install_path": "/opt/gameservers/my_game",
  "branch": "public",
  "launch_args": ["-port 2456", "-nographics", "-batchmode"],
  "executable": "start_server.sh",
  "rcon": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 27015,
    "password": "changeme"
  },
  "restart_schedule": "0 4 * * *",
  "update_schedule": "30 3 * * 0",
  "restart_warning_minutes": 5,
  "auto_restart_on_crash": true,
  "max_crash_restarts": 5,
  "health_rules": [
    {
      "id": "crash_keyword",
      "description": "Auto-restart on fatal crash log line",
      "pattern": "(FATAL|Segmentation fault|core dumped)",
      "threshold": 1,
      "window_seconds": 10,
      "action": "restart",
      "enabled": true
    },
    {
      "id": "high_error_rate",
      "description": "Notify admin on high error rate",
      "pattern": "\\bERROR\\b",
      "threshold": 20,
      "window_seconds": 60,
      "action": "notify",
      "enabled": true
    }
  ],
  "permissions": {
    "76561198000000001": "admin",
    "76561198000000002": "moderator"
  },
  "whitelist": [],
  "notifications": {
    "discord_webhook": null,
    "email": null
  },
  "log_path": "logs/server.log",
  "tags": ["example", "game"]
}
