<Window x:Class="ArbiterHost.IdeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Arbiter IDE"
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DarkBgBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- Monaco editor -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Brand -->
                <TextBlock Text="⬡  Arbiter"
                           FontWeight="Bold" FontSize="13"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,14,0"/>

                <Separator Width="1" Height="20" Margin="0,0,8,0"
                           Background="{StaticResource BorderBrush}"/>

                <!-- File actions -->
                <Button Name="OpenFolderBtn"   Content="📂 Open Folder"  Margin="2" Padding="8,5"
                        Click="OpenFolder_Click"  ToolTip="Open project folder"/>
                <Button Name="OpenFileBtn"     Content="📄 Open File"    Margin="2" Padding="8,5"
                        Click="OpenFile_Click"    ToolTip="Open a single file"/>
                <Button Name="SaveFileBtn"     Content="💾 Save"         Margin="2" Padding="8,5"
                        Click="Save_Click"        ToolTip="Save current file (Ctrl+S)"/>

                <Separator Width="1" Height="20" Margin="6,0"
                           Background="{StaticResource BorderBrush}"/>

                <!-- Build/Run/Test actions -->
                <Button Name="BuildBtn"  Content="🔨 Build"  Margin="2" Padding="8,5"
                        Click="Build_Click"  ToolTip="Build project"/>
                <Button Name="RunBtn"    Content="▶ Run"    Margin="2" Padding="8,5"
                        Click="Run_Click"    ToolTip="Run project"/>
                <Button Name="TestBtn"   Content="✅ Test"   Margin="2" Padding="8,5"
                        Click="Test_Click"   ToolTip="Run tests"/>

                <Separator Width="1" Height="20" Margin="6,0"
                           Background="{StaticResource BorderBrush}"/>

                <!-- Project selector -->
                <TextBlock Text="Project:" VerticalAlignment="Center" Margin="4,0,4,0"
                           Foreground="{StaticResource DimForegroundBrush}"/>
                <ComboBox Name="ProjectSelector" Width="160" Margin="2"
                          SelectionChanged="ProjectSelector_SelectionChanged"
                          ToolTip="Switch active project"/>

                <Separator Width="1" Height="20" Margin="6,0"
                           Background="{StaticResource BorderBrush}"/>

                <!-- Server status indicator -->
                <Ellipse Name="ServerDot" Width="10" Height="10" Fill="Gray"
                         VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBlock Name="ServerLabel" Text="Connecting…"
                           FontSize="11"
                           Foreground="{StaticResource DimForegroundBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
            </WrapPanel>
        </Border>

        <!-- ── Monaco IDE (WebView2) ── -->
        <wv2:WebView2 Grid.Row="1" Name="IdeWebView"/>

        <!-- ── Status bar ── -->
        <Border Grid.Row="2"
                Background="{StaticResource AccentBrush}"
                Padding="8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="StatusLabel"
                           Grid.Column="0"
                           Text="Ready"
                           FontSize="11"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock Name="ModeLabel"
                           Grid.Column="1"
                           FontSize="11"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
